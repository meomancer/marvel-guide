{
  "id": "empyre-2020-3",
  "synopsis": [
    {
      "kind": "paragraph",
      "text": "The tag-team action comes home!"
    },
    {
      "kind": "paragraph",
      "text": "Wakanda is the battleground – as the Avengers and the FF unite to prevent a Vibranium-powered threat to all life as we know it!"
    },
    {
      "kind": "paragraph",
      "text": "A long-lost Avenger returns to active duty – but will that be enough to turn the tide?"
    },
    {
      "kind": "paragraph",
      "text": "And in space, interstellar intrigue threatens the fragile Kree/Skrull alliance...and the repercussions might just doom planet Earth!"
    }
