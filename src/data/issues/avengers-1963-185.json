{
  "id": "avengers-1963-185",
  "name": "The Yesterday Quest!",
  "synopsis": [
    {
      "kind": "paragraph",
      "text": "After the Scarlet Witch is plagued by dream visions from her past, she and twin brother Pietro return to Wundagore for answers. What strange creatures from the twins’ past will aid them in their future quests? And will the Avengers actually pay for the damages incurred in their battle with the Absorbing Man?"
    },
    {
      "kind": "paragraph",
      "text": "Quicksilver contacts the Avengers for help as his sister is being possesed by Chthon."
    },
    {
      "kind": "heading",
      "text": "Notes"
    },
    {
      "kind": "paragraph",
      "text": "This issue won the Eagle Award for Favorite Comicbook Cover presented in 1980."
    },
    {
      "kind": "paragraph",
      "text": "Jim Salicrup's assistant editor credit taken from letters page header."
    },
    {
      "kind": "paragraph",
      "text": "Features the Hostess Fruit Pies ad, The Thing And The Ultimate Weapon!"
    },
    {
      "kind": "paragraph",
      "text": "Features the origin of Quicksilver and the Scarlet Witch."
    }
  ],
