  "name": "The Horns of Doom",
  "synopsis": [
    {
      "kind": "paragraph",
      "text": "Drax has long been known as \"The Destroyer\"...but no more! He has forsaken all violence, and sworn never to again strike another in anger!"
    },
    {
      "kind": "paragraph",
      "text": "And now, guest artist Greg Smallwood joins series writer Gerry Duggan to reveal what led our boy down the road of peace!"
    }
