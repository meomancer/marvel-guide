  "synopsis": [
    {
      "kind": "paragraph",
      "text": "Doctor Strange is presented with a dread bargain to gain a chance to save the world. The Avengers ride into a battle they cannot win. The dead battle the undead across the globe."
    },
    {
      "kind": "paragraph",
      "text": "Will it be enough? Will the world be saved, and how will it be changed if it is?"
    },
