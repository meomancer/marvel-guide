  "synopsis": [
    {
      "kind": "paragraph",
      "text": "The Kree and the Skrulls have united under a new emperor - and their war fleet is on a collision course for our world."
    },
    {
      "kind": "paragraph",
      "text": "On the moon, the Avengers are ready to strike with the full power of Earth's Mightiest Heroes. Approaching from outer space, the Fantastic Four are seeking a diplomatic solution."
    },
    {
      "kind": "paragraph",
      "text": "If the two teams can't work together to save the day, things can only get worse..."
    }
